{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "react-dom"],
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/webview/**/*.tsx", "src/webview/**/*.ts", "src/shared/**/*.ts"]
}
